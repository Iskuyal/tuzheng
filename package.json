{
  "name": "tuzheng",
  "version": "0.1.0",
  "private": true,
  "description": "图证：图表证据审计台",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iskuyal/tuzheng.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/check-ports.ts && concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:ports": "tsx scripts/check-ports.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config config/vite.config.ts && tsc -p config/tsconfig.server.build.json",
    "typecheck": "vue-tsc --noEmit -p config/tsconfig.web.json && tsc --noEmit -p config/tsconfig.server.json && tsc --noEmit -p config/tsconfig.e2e.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:recording": "node --import tsx --test docs/submission/code-demo/capture-budget.test.mjs",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "eval:samples": "tsx scripts/evaluate-samples.ts",
    "eval:source-audit": "tsx scripts/evaluate-source-audit.ts",
    "eval:holdout": "tsx scripts/evaluate-holdout.ts",
    "eval:preflight": "tsx scripts/candidate-preflight.ts",
    "eval:holdout:http": "tsx scripts/run-holdout-http.ts",
    "eval:demo:http": "tsx scripts/run-demo-http.ts",
    "study:readers": "tsx scripts/user-study.ts",
    "verify:sample-renders": "node scripts/verify-sample-renders.mjs",
    "verify:model-config": "tsx scripts/verify-model-config.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "openai": "^5.20.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.0.8"
  }
}
