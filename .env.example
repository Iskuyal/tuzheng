# 可选：本地 Express API 端口，默认 3001。
PORT=3001
# 可选：网页（Vite）端口，默认 5173。两个端口被占用时都会直接报错并提示清理，不会自动换端口。
WEB_PORT=5173
# 模型配置来源：留空或 file 使用本机设置页（默认）；显式填 env 启用服务端环境配置。
# env 模式下面四项必须完整填写；不读取或写入本机设置文件，不逐字段回退。
# 模板只留空值。实际密钥由运行环境注入，禁止提交包含密钥的 .env 或截图／日志。
MODEL_CONFIG_SOURCE=
# openai-responses 或 anthropic（协议标识，并非服务商名称）
MODEL_PROVIDER=
# HTTPS 服务根地址；HTTP 仅限回环。不能填写完整 /responses 或 /messages 端点。
MODEL_BASE_URL=
# 服务端所用的模型名称
MODEL_NAME=
# 仅服务端内存使用，不回传、不写回设置文件
MODEL_API_KEY=
