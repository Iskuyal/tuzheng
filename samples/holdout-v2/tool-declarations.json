[
  {
    "name": "search_source_library",
    "description": "在国家统计局固定资料库中检索材料。按指标、月份、范围返回候选，命中里可能包含口径不同的干扰材料，需要自行判断是否适用。",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": [
            "string",
            "null"
          ],
          "description": "指标名，例如「全国居民消费价格」；不确定时填 null。"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "description": "要核对的月份，写成 YYYY-MM；不确定时填 null。"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "地域或人群，例如「全国」；不确定时填 null。"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可选自由词，例如「同比」「环比」。"
        }
      },
      "required": [
        "metric",
        "period",
        "scope"
      ]
    }
  },
  {
    "name": "compare_values",
    "description": "对两个数值做确定性的相等或差异计算，不做现实数据判断。",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "这次比较的用途。"
        }
      },
      "required": [
        "left",
        "right",
        "unit"
      ]
    }
  },
  {
    "name": "request_clarification",
    "description": "资料库检索后仍缺会影响结论的口径时，向用户提一个具体问题。先自己检索，资料库已覆盖的问题不要问用户。单次调查最多一次。",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "description": "要问用户的一个具体问题。"
        },
        "purpose": {
          "type": "string",
          "description": "这个答案会怎样影响结论、影响哪项口径。"
        },
        "field": {
          "type": "string",
          "enum": [
            "period",
            "scope",
            "metric",
            "basis",
            "value"
          ]
        },
        "claimText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "这条追问影响的主张原文（逐字引用该主张）；不影响具体主张时填 null。"
        }
      },
      "required": [
        "question",
        "purpose",
        "field",
        "claimText"
      ]
    }
  },
  {
    "name": "report_source_finding",
    "description": "结束调查并给出结构化结果。必须在看完工具结果之后再调用；引用只能来自本次检索命中的资料。最多核验 3 条主张，未展开的配文内容必须写进 omittedClaims。可以在 rewrites 里附上逐条配文改写提议（可选）；程序会按结论逐条校验，不合格的不会被采用。",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claims": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claimText": {
                "type": "string",
                "description": "逐字保留的主张原文，不要改写；配文主张必须是配文里出现过的文字。"
              },
              "metric": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "basis": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "year-on-year",
                      "month-on-month"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "同比为 year-on-year，环比为 month-on-month；文中没写比较方式时填 null。推断类主张必须填它依赖的比较方式。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "direct",
                  "inference",
                  "opinion"
                ],
                "description": "direct 为原文直接陈述；inference 为由原文推出、原文没有直接写的可检查结论（例如从「同比涨幅下降」推出「比上月便宜」）；opinion 为对原因、动机、价值或未来走势的观点，这类不支持核验，不会被判错。"
              },
              "direction": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "主张断言的价格水平方向：价格比上期更高填 up，更低填 down；没有方向、或主张说的是「涨幅回落／涨幅扩大」这类涨幅本身的变化时填 null。"
              },
              "fromImage": {
                "type": "boolean",
                "description": "这条主张是否来自图片上的文字。"
              },
              "imageExcerpt": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "从图上逐字抄录、支撑这条主张的文字。图上没有对应文字时填 null；程序会据此核对比较方式是否真的写在图上。"
              }
            },
            "required": [
              "claimText",
              "metric",
              "scope",
              "period",
              "value",
              "basis",
              "kind",
              "direction",
              "fromImage",
              "imageExcerpt"
            ]
          },
          "description": "最多核验 3 条主张；配文更长时，把没有展开的原文放进 omittedClaims，不能省略。"
        },
        "citations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string",
                "description": "必须是本次检索结果里出现过的资料 ID。"
              },
              "role": {
                "type": "string",
                "enum": [
                  "value-basis",
                  "term-explanation",
                  "context"
                ],
                "description": "value-basis 表示用它的数值核对主张；term-explanation 只用于解释术语。"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "sourceId",
              "role",
              "note"
            ]
          }
        },
        "noApplicableSourceReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "本次没有适用来源时说明原因；有适用来源时填 null。"
        },
        "unresolvedItems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "证据不足、仍未解决的问题。"
        },
        "omittedClaims": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          },
          "description": "配文里没有展开成主张的原文片段（逐字保留）；配文超过 3 条主张时，多出来的必须写在这里，没有就填空数组。只放配文原文，不要放图上说明文字。"
        },
        "rewrites": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claimText": {
                "type": "string",
                "description": "这条改写针对的主张原文（逐字引用）。"
              },
              "suggestedText": {
                "type": "string",
                "description": "建议的配文写法：保持原句结构，只改有依据的部分；与所引来源不一致时用来源里的正确数值替换错误值；没有适用来源或推断依据不足时必须保留限定词（例如「暂未核实」）；建议删除这句时填空字符串。"
              },
              "reason": {
                "type": "string",
                "description": "为什么这样改，引用所依据的来源。"
              }
            },
            "required": [
              "claimText",
              "suggestedText",
              "reason"
            ]
          },
          "description": "可选的逐条改写提议。规则：与所引来源一致的主张原样保留；不得引入图上、配文与所引来源里都没有的数值、月份或范围，也不要新增原文没有的因果或加强表述；程序会逐条校验，不合格的提议不会被采用。没有把握时填空数组。"
        }
      },
      "required": [
        "claims",
        "citations",
        "noApplicableSourceReason",
        "unresolvedItems",
        "omittedClaims"
      ]
    }
  }
]
